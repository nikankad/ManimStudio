  "storyboard": {
    "beats": [
      {
        "id": "explain_0",
        "title": "Introduce the curve",
        "steps": [
          "s1",
          "s2"
        ],
        "script": "Start with a curve. We want to understand its slope at one point.",
        "cues": []
      },
      {
        "id": "explain_1",
        "title": "Construct a secant",
        "steps": [
          "s3",
          "s4"
        ],
        "script": "These two points determine a secant. Its slope measures the average rate of change.",
        "cues": []
      },
      {
        "id": "explain_2",
        "title": "Shrink the separation",
        "steps": [
          "s5",
          "s6"
        ],
        "script": "Bring Q closer to P. As the separation shrinks, watch the secant and its slope change together.",
        "cues": [
          {
            "id": "closer",
            "phrase": "Bring Q closer to P",
            "step": "s5",
            "edge": "start",
            "offset": 0
          }
        ]
      },
      {
        "id": "explain_3",
        "title": "Explain the tangent",
        "steps": [
          "s7",
          "s8"
        ],
        "script": "The green tangent shows the limiting slope at P. We stop h above zero and construct the tangent explicitly.",
        "cues": []
      }
    ]
