{
  "version": 2,
  "scene": {
    "name": "SineTracker",
    "base": "Scene"
  },
  "config": {
    "pixel_width": 1920,
    "pixel_height": 1080,
    "frame_rate": 60,
    "background_color": "#000000"
  },
  "header": "class Spiral(VMobject):\n    \"\"\"Custom mobject defined in the header: it shows up in the library.\"\"\"\n\n    def __init__(self, turns=3, size=1.0, **kwargs):\n        super().__init__(**kwargs)\n        ts = np.linspace(0, turns * TAU, 240)\n        r = size * ts / (turns * TAU)\n        self.set_points_smoothly(np.stack([r * np.cos(ts), r * np.sin(ts), 0 * ts], axis=1))\n",
  "objects": [
    {
      "id": "o_title",
      "name": "title",
      "ctor": "Text",
      "args": {
        "*": "r\"Tracing sin(x)\"",
        "font_size": "42"
      },
      "pos": [
        0,
        3.25
      ],
      "chain": ""
    },
    {
      "id": "o_axes",
      "name": "axes",
      "ctor": "Axes",
      "args": {
        "x_range": "[-7, 7, 1]",
        "y_range": "[-1.5, 1.5, 0.5]",
        "x_length": "11",
        "y_length": "4",
        "axis_config": "{\"color\": GREY}"
      },
      "pos": [
        0,
        -0.4
      ],
      "chain": ""
    },
    {
      "id": "o_graph",
      "name": "graph",
      "ctor": "axes.plot",
      "args": {
        "function": "lambda x: np.sin(x)",
        "color": "BLUE"
      },
      "pos": null,
      "chain": ""
    },
    {
      "id": "o_t",
      "name": "t",
      "ctor": "ValueTracker",
      "args": {
        "*": "-6"
      },
      "pos": null,
      "chain": ""
    },
    {
      "id": "o_dot",
      "name": "dot",
      "ctor": "Dot",
      "args": {
        "color": "YELLOW",
        "radius": "0.12"
      },
      "pos": null,
      "chain": ".add_updater(lambda m: m.move_to(axes.i2gp(t.get_value(), graph)))"
    },
    {
      "id": "o_spiral",
      "name": "spiral",
      "ctor": "Spiral",
      "args": {
        "turns": "4",
        "size": "0.9",
        "color": "PINK"
      },
      "pos": [
        5.25,
        2.5
      ],
      "chain": ""
    }
  ],
  "tracks": [
    {
      "id": "t1",
      "name": "V1"
    },
    {
      "id": "t2",
      "name": "V2"
    },
    {
      "id": "t3",
      "name": "V3"
    }
  ],
  "clips": [
