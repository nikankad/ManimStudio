  "header": "",
  "objects": [
    {
      "id": "o60c3a3e",
      "name": "title",
      "ctor": "Text",
      "args": {
        "*": "\"Odd \u00d7 Odd = Odd\"",
        "font_size": "72",
        "t2c": "{\"Odd\": YELLOW}"
      },
      "pos": null,
      "chain": "",
      "comment": "# ---- Title"
    },
    {
      "id": "o0b12be2",
      "name": "subtitle",
      "ctor": "Text",
      "args": {
        "*": "\"Why multiplying two odd numbers always gives an odd number\"",
        "font_size": "28",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".next_to(title, DOWN, buff=0.4)"
    },
    {
      "id": "o52ebbd2",
      "name": "heading",
      "ctor": "Text",
      "args": {
        "*": "\"What makes a number odd?\"",
        "font_size": "44"
      },
      "pos": null,
      "chain": ".to_edge(UP, buff=0.6)",
      "after": "se01f506",
      "comment": "# ---- What makes a number odd: pairs plus one left over"
    },
    {
      "id": "ocbb2936",
      "name": "pairs",
      "ctor": "VGroup",
      "args": {
        "*": "*[Dot(radius=0.2, color=BLUE) for _ in range(6)]"
      },
      "pos": null,
      "chain": ".arrange_in_grid(rows=2, cols=3, buff=0.4).shift(LEFT * 0.4 + UP * 0.6)",
      "after": "se01f506"
    },
    {
      "id": "o54c28af",
      "name": "seven",
      "ctor": "Text",
      "args": {
        "*": "\"7 = 2 \u00d7 3 + 1\"",
        "font_size": "44",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(pairs, DOWN, buff=0.7)",
      "after": "sf338ef1"
    },
    {
      "id": "o825dc9e",
      "name": "rule",
      "ctor": "Text",
      "args": {
        "*": "\"Every odd number is pairs plus one left over:  2k + 1\"",
        "font_size": "32",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(seven, DOWN, buff=0.6)",
      "after": "sf338ef1"
    },
    {
      "id": "o3381a8f",
      "name": "heading2",
      "ctor": "Text",
      "args": {
        "*": "\"Take any two odd numbers\"",
        "font_size": "44"
      },
      "pos": null,
      "chain": ".to_edge(UP, buff=0.6)",
      "after": "sbea666b",
      "comment": "# ---- The algebra"
    },
    {
      "id": "obcef403",
      "name": "line1",
      "ctor": "Text",
      "args": {
        "*": "\"m = 2a + 1,    n = 2b + 1\"",
        "font_size": "40",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(heading2, DOWN, buff=0.7)",
      "after": "sbea666b"
    },
    {
      "id": "o480ee82",
      "name": "line2",
      "ctor": "Text",
      "args": {
        "*": "\"m \u00d7 n = (2a + 1)(2b + 1)\"",
        "font_size": "40",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(line1, DOWN, buff=0.45)",
      "after": "sbea666b"
    },
    {
      "id": "o7c690eb",
      "name": "line3",
      "ctor": "Text",
      "args": {
        "*": "\"= 4ab + 2a + 2b + 1\"",
        "font_size": "40",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(line2, DOWN, buff=0.45)",
      "after": "sbea666b"
    },
    {
      "id": "o34ebe42",
      "name": "line4",
      "ctor": "Text",
      "args": {
        "*": "\"= 2(2ab + a + b) + 1\"",
        "font_size": "40",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(line3, DOWN, buff=0.45)",
      "after": "sbea666b"
    },
    {
      "id": "o8390462",
      "name": "line5",
      "ctor": "Text",
      "args": {
        "*": "\"= 2k + 1\"",
        "font_size": "40",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(line4, DOWN, buff=0.45)",
      "after": "sbea666b"
    },
    {
      "id": "o038ff26",
      "name": "note3",
      "ctor": "Text",
      "args": {
        "*": "\"multiply out\"",
        "font_size": "26",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".next_to(line3, RIGHT, buff=0.6)",
      "after": "s102b20c"
    },
    {
      "id": "o8d371f6",
      "name": "note4",
      "ctor": "Text",
      "args": {
        "*": "\"take out a 2\"",
        "font_size": "26",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".next_to(line4, RIGHT, buff=0.6)",
      "after": "s102b20c"
    },
    {
      "id": "o697253f",
      "name": "note5",
      "ctor": "Text",
      "args": {
        "*": "\"where k = 2ab + a + b\"",
        "font_size": "26",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".next_to(line5, RIGHT, buff=0.6)",
      "after": "s102b20c"
    },
    {
      "id": "o028ffc8",
      "name": "box",
      "ctor": "SurroundingRectangle",
      "args": {
        "*": "line5",
        "color": "YELLOW",
        "buff": "0.15"
      },
      "pos": null,
      "chain": "",
      "after": "s102b20c"
    },
    {
      "id": "o4dff84c",
      "name": "heading3",
      "ctor": "Text",
      "args": {
        "*": "\"See it with dots:  3 \u00d7 5\"",
        "font_size": "44"
      },
      "pos": null,
      "chain": ".to_edge(UP, buff=0.6)",
      "after": "s903ced5",
      "comment": "# ---- See it with dots: a 3 \u00d7 5 grid pairs up except one corner"
    },
    {
      "id": "o0301f5a",
      "name": "grid",
      "ctor": "VGroup",
      "args": {
        "*": "*[Dot(radius=0.18, color=BLUE) for _ in range(15)]"
      },
      "pos": null,
      "chain": ".arrange_in_grid(rows=3, cols=5, buff=0.55).shift(DOWN * 0.2)",
      "after": "s903ced5"
    },
    {
      "id": "o0e8389d",
      "name": "dominoes",
      "ctor": "VGroup",
      "args": {
        "*": "*[SurroundingRectangle(VGroup(grid[i], grid[j]), buff=0.12, corner_radius=0.18, color=GREEN)\nfor i, j in [(0, 1), (2, 3), (5, 6), (7, 8), (10, 11), (12, 13), (4, 9)]]"
      },
      "pos": null,
      "chain": "",
      "after": "s903ced5"
    },
    {
      "id": "o513b335",
      "name": "count",
      "ctor": "Text",
      "args": {
        "*": "\"7 pairs + 1 left over = 15, which is odd\"",
        "font_size": "34",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(grid, DOWN, buff=0.8)",
      "after": "s903ced5"
    },
    {
      "id": "o10a1ed0",
      "name": "general",
      "ctor": "Text",
      "args": {
        "*": "\"Any odd \u00d7 odd grid pairs up except one corner dot\"",
        "font_size": "30",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".next_to(count, DOWN, buff=0.35)",
      "after": "s903ced5"
    },
    {
      "id": "o6e010ea",
      "name": "final",
      "ctor": "Text",
      "args": {
        "*": "\"Odd \u00d7 Odd = Odd\"",
        "font_size": "72",
        "t2c": "{\"Odd\": YELLOW}"
      },
      "pos": null,
      "chain": "",
      "after": "s8424e42",
      "comment": "# ---- Conclusion"
    },
    {
      "id": "ocbd995c",
      "name": "proof",
      "ctor": "Text",
      "args": {
        "*": "\"(2a + 1)(2b + 1) = 2k + 1\"",
        "font_size": "40",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(final, DOWN, buff=0.5)",
      "after": "s8424e42"
    },
    {
      "id": "odec8a0c",
      "name": "aside",
      "ctor": "Text",
      "args": {
        "*": "\"But odd + odd is even: the two left-over ones make a pair.\"",
        "font_size": "28",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".to_edge(DOWN, buff=0.8)",
      "after": "s8424e42"
    }
  ],
