    {
      "id": "o8b6f02e",
      "name": "final",
      "ctor": "Text",
      "args": {
        "*": "\"Odd + Odd = Even\"",
        "font_size": "72",
        "t2c": "{\"Odd\": YELLOW, \"Even\": GREEN}"
      },
      "pos": null,
      "chain": "",
      "after": "sf3c8d0e",
