  "header": "",
  "objects": [
    {
      "id": "o6dc86a0",
      "name": "title",
      "ctor": "Text",
      "args": {
        "*": "\"Odd + Odd = Even\"",
        "font_size": "72",
        "t2c": "{\"Odd\": YELLOW, \"Even\": GREEN}"
      },
      "pos": null,
      "chain": "",
      "comment": "# ---- Title"
    },
    {
      "id": "o234c402",
      "name": "subtitle",
      "ctor": "Text",
      "args": {
        "*": "\"Why adding two odd numbers always gives an even number\"",
        "font_size": "28",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".next_to(title, DOWN, buff=0.4)"
    },
    {
      "id": "o0af27cb",
      "name": "heading",
      "ctor": "Text",
      "args": {
        "*": "\"Even numbers pair up. Odd numbers have one left over.\"",
        "font_size": "34"
      },
      "pos": null,
      "chain": ".to_edge(UP, buff=0.6)",
      "after": "s09d14f6",
      "comment": "# ---- Even numbers pair up; odd numbers have one left over"
    },
    {
      "id": "o657563d",
      "name": "six",
      "ctor": "VGroup",
      "args": {
        "*": "*[Dot(radius=0.2, color=BLUE) for _ in range(6)]"
      },
      "pos": null,
      "chain": ".arrange_in_grid(rows=2, cols=3, buff=0.4).shift(LEFT * 3.2 + UP * 0.3)",
      "after": "s09d14f6"
    },
    {
      "id": "ob49a6aa",
      "name": "seven",
      "ctor": "VGroup",
      "args": {
        "*": "*[Dot(radius=0.2, color=BLUE) for _ in range(6)]"
      },
      "pos": null,
      "chain": ".arrange_in_grid(rows=2, cols=3, buff=0.4).shift(RIGHT * 2.4 + UP * 0.3)",
      "after": "s09d14f6"
    },
    {
      "id": "odbd2946",
      "name": "six_label",
      "ctor": "Text",
      "args": {
        "*": "\"6 = 2k  \u2192  even\"",
        "font_size": "34",
        "t2c": "{\"even\": GREEN}"
      },
      "pos": null,
      "chain": ".next_to(six, DOWN, buff=0.7)",
      "after": "s1b4157f"
    },
    {
      "id": "of32b59e",
      "name": "seven_label",
      "ctor": "Text",
      "args": {
        "*": "\"7 = 2k + 1  \u2192  odd\"",
        "font_size": "34",
        "t2c": "{\"+ 1\": YELLOW, \"odd\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(seven, DOWN, buff=0.7)",
      "after": "s1b4157f"
    },
    {
      "id": "of2d07d8",
      "name": "heading2",
      "ctor": "Text",
      "args": {
        "*": "\"Add any two odd numbers\"",
        "font_size": "44"
      },
      "pos": null,
      "chain": ".to_edge(UP, buff=0.6)",
      "after": "sc4dd874",
      "comment": "# ---- The algebra"
    },
    {
      "id": "oc725d2e",
      "name": "line1",
      "ctor": "Text",
      "args": {
        "*": "\"m = 2a + 1,    n = 2b + 1\"",
        "font_size": "40",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(heading2, DOWN, buff=0.7)",
      "after": "sc4dd874"
    },
    {
      "id": "o57dad1e",
      "name": "line2",
      "ctor": "Text",
      "args": {
        "*": "\"m + n = (2a + 1) + (2b + 1)\"",
        "font_size": "40",
        "t2c": "{\"+ 1\": YELLOW}"
      },
      "pos": null,
      "chain": ".next_to(line1, DOWN, buff=0.45)",
      "after": "sc4dd874"
    },
    {
      "id": "ob466b4b",
      "name": "line3",
      "ctor": "Text",
      "args": {
        "*": "\"= 2a + 2b + 2\"",
        "font_size": "40",
        "t2c": "{\"[11:13]\": GREEN}"
      },
      "pos": null,
      "chain": ".next_to(line2, DOWN, buff=0.45)",
      "after": "sc4dd874"
    },
    {
      "id": "of26c561",
      "name": "line4",
      "ctor": "Text",
      "args": {
        "*": "\"= 2(a + b + 1)\"",
        "font_size": "40"
      },
      "pos": null,
      "chain": ".next_to(line3, DOWN, buff=0.45)",
      "after": "sc4dd874"
    },
    {
      "id": "of3dc9a2",
      "name": "line5",
      "ctor": "Text",
      "args": {
        "*": "\"= 2k\"",
        "font_size": "40",
        "t2c": "{\"2k\": GREEN}"
      },
      "pos": null,
      "chain": ".next_to(line4, DOWN, buff=0.45)",
      "after": "sc4dd874"
    },
    {
      "id": "oa363dd3",
      "name": "note3",
      "ctor": "Text",
      "args": {
        "*": "\"the two 1s make 2\"",
        "font_size": "26",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".next_to(line3, RIGHT, buff=0.6)",
      "after": "sc4cb255"
    },
    {
      "id": "o886ff61",
      "name": "note4",
      "ctor": "Text",
      "args": {
        "*": "\"take out a 2\"",
        "font_size": "26",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".next_to(line4, RIGHT, buff=0.6)",
      "after": "sc4cb255"
    },
    {
      "id": "o33930cd",
      "name": "note5",
      "ctor": "Text",
      "args": {
        "*": "\"where k = a + b + 1\"",
        "font_size": "26",
        "color": "GREY_B"
      },
      "pos": null,
      "chain": ".next_to(line5, RIGHT, buff=0.6)",
      "after": "sc4cb255"
    },
    {
      "id": "o05e2dfe",
      "name": "box",
      "ctor": "SurroundingRectangle",
      "args": {
        "*": "line5",
        "color": "GREEN",
        "buff": "0.15"
      },
      "pos": null,
      "chain": "",
      "after": "sc4cb255"
    },
    {
      "id": "o64add03",
      "name": "heading3",
      "ctor": "Text",
      "args": {
        "*": "\"See it with dots:  5 + 7\"",
        "font_size": "44"
      },
      "pos": null,
      "chain": ".to_edge(UP, buff=0.6)",
