    },
    {
      "id": "o1b997bb",
      "name": "proof",
      "ctor": "Text",
      "args": {
        "*": "\"(2a + 1) + (2b + 1) = 2(a + b + 1)\"",
        "font_size": "40",
        "t2c": "{\"2(a + b + 1)\": GREEN}"
      },
      "pos": null,
      "chain": ".next_to(final, DOWN, buff=0.5)",
      "after": "sf3c8d0e"
