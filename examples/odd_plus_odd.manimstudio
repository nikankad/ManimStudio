    {
      "id": "o31f750a",
      "name": "dominoes",
      "ctor": "VGroup",
      "args": {
        "*": "*[SurroundingRectangle(VGroup(a, b), buff=0.12, corner_radius=0.18, color=GREEN)\nfor a, b in [(five[0], five[2]), (five[1], five[3]), (five_extra, seven2_extra),\n             (seven2[0], seven2[3]), (seven2[1], seven2[4]), (seven2[2], seven2[5])]]"
      },
      "pos": null,
      "chain": "",
      "after": "s879d656"
    },
    {
      "id": "o23a41be",
      "name": "count",
      "ctor": "Text",
      "args": {
        "*": "\"5 + 7 = 12 = 6 pairs, nothing left over: even\"",
        "font_size": "34",
        "t2c": "{\"even\": GREEN}"
      },
      "pos": null,
      "chain": ".next_to(seven2, DOWN, buff=0.9).set_x(0)",
